{
  "name": "lovelace-home-widgets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "description": "Mobile-first Home Assistant dashboard widgets",
  "license": "MIT",
  "repository": "https://github.com/alxleo/lovelace-home-widgets.git",
  "keywords": ["home-assistant", "hacs", "lovelace", "custom-card"],
  "scripts": {
    "build": "rollup -c",
    "check": "npm run typecheck && npm run test && npm audit && npm run build && npm run verify:dist && npm run privacy && npm run test:e2e && npm run visual:contract && npm run privacy:artifacts",
    "preview": "npm run build && node tools/static-server.mjs",
    "privacy": "node tools/privacy-guard.mjs",
    "privacy:private": "node tools/privacy-guard.mjs --require-private-policy",
    "privacy:artifacts": "node tools/release-artifact-privacy.mjs",
    "sources:fetch": "node tools/source-workshop.mjs fetch",
    "sources:search": "node tools/source-workshop.mjs search",
    "sources:board": "node tools/source-workshop.mjs board",
    "test": "vitest run tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "visual:contract": "node tools/visual-contract.mjs",
    "verify:dist": "git ls-files --error-unmatch dist/alx-home-widgets.js && git cat-file -e HEAD:dist/alx-home-widgets.js && git diff --exit-code HEAD -- dist/alx-home-widgets.js"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "26.4.0",
    "entities": "8.0.0",
    "rollup": "4.63.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
